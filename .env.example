# ─── Supabase (required for backend mode) ────────────────────────────────────
# Get these from: https://supabase.com/dashboard → project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI key is SERVER-SIDE ONLY — never put it in the client bundle.
# Set it in Supabase secrets:  supabase secrets set OPENAI_API_KEY=sk-...

# ─── Google Sign In ──────────────────────────────────────────────────────────
# 1. console.cloud.google.com → NEW project "PhysiqueMax" (do not reuse old OAuth clients)
# 2. APIs & Services → OAuth consent screen → External → add your Gmail as Test user
# 3. Credentials → Web application (for Supabase + later web)
#    - Do NOT use auth.expo.io (deprecated, returns Not Found)
# 4. Credentials → iOS application — REQUIRED for Expo Go on iPhone:
#    - Bundle ID: host.exp.Exponent  (not ai.aesthetix.app)
#    - Copy iOS Client ID → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID below
# 5. Credentials → iOS application — for App Store / dev build:
#    - Bundle ID: ai.aesthetix.app
# 6. Supabase → Authentication → Providers → Google → Enable
#    - Client ID + secret = Web client
#    - "Authorized Client IDs" (if shown): add BOTH Web + iOS client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-expo-go-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ─── Apple Sign In ───────────────────────────────────────────────────────────
# 1. developer.apple.com → App ID ai.aesthetix.app + Services ID ai.aesthetix.auth
# 2. Key (.p8) → JWT: node scripts/generate-apple-jwt.js ~/Downloads/AuthKey_*.p8
# 3. Supabase → Authentication → Providers → Apple → Enable
#    - Client IDs: ai.aesthetix.app,ai.aesthetix.auth
#    - Secret Key: JWT (eyJ...), NOT the raw .p8 file
# 4. Supabase → URL Configuration → Redirect URLs: aesthetix://auth/callback

# ─── Email confirmation (Supabase Auth → URL Configuration) ─────────────────
# Add every redirect URL the app uses (run the app once and check Metro logs, or log
# getEmailAuthRedirectUrl() from src/auth/authRedirect.ts). Examples:
#   aesthetix://auth/callback
#   exp://127.0.0.1:8081/--/auth/callback          (Expo Go on simulator)
#   exp://192.168.x.x:8081/--/auth/callback       (Expo Go on device, LAN)
# Site URL can stay as your production web URL; redirect URLs must include the list above.
#
# Dev tip — avoid "email rate limit" while testing signups:
# Supabase Dashboard → Authentication → Providers → Email → disable "Confirm email".
# Or confirm users manually: Authentication → Users → user → Confirm email.

# ─── Error tracking (Sentry) ──────────────────────────────────────────────────
# Requires prebuild/EAS build (NOT Expo Go). See docs/NATIVE_SECURITY.md.
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Local expo run:ios — avoid xcodebuild failure without Sentry org:
SENTRY_DISABLE_AUTO_UPLOAD=true
# EAS production (source maps): SENTRY_ORG= SENTRY_PROJECT= SENTRY_AUTH_TOKEN=

# ─── SSL pinning (Supabase) ───────────────────────────────────────────────────
# Set at PREBUILD time. Production EAS profile sets this true automatically.
# EXPO_PUBLIC_SSL_PINNING_ENABLED=false

# ─── App Config ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development

# Apple Sign In: leave unset (enabled). Set true only for free Personal Team without paid Developer.
# EXPO_PUBLIC_DISABLE_APPLE_SIGNIN=true

# Set to true to skip all network calls and use local mock data instead.
EXPO_PUBLIC_USE_MOCK_API=true

# ─── In-app purchases (RevenueCat → App Store / Google Play) ─────────────────
# false = local mock plans (no real payment). true = real IAP (requires dev build, not Expo Go).
# Setup checklist (PL): docs/PAYMENTS_PL.md
EXPO_PUBLIC_IAP_ENABLED=false
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# ─── TikTok Ads (app attribution only) ───────────────────────────────────────
# TikTok Ads Manager → Events → App ID + Access Token. Dev/EAS build required.
# EXPO_PUBLIC_TIKTOK_APP_ID=your-tiktok-app-id
# EXPO_PUBLIC_TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
